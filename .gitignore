# --- secrets: never commit ---
.env
.env.local
.streamlit/secrets.toml

# --- private data: partner's mental-health info never leaves this machine ---
# 注意 data/* 而不是 data/：git 无法「重新包含」一个被排除目录下的文件，
# 所以必须先排除目录内容，再逐个放行想留在仓库里的说明文件。
data/*
!data/raw_media/
data/raw_media/*
!data/raw_media/README.md
!data/transcripts/
data/transcripts/*
!data/transcripts/README.md
!data/distilled/
data/distilled/*
!data/distilled/README.md

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# 评测产出是模型输出，不是代码；data/ 已整体忽略，这里只是说明
# data/generation_eval/

# --- personal: interview prep, stays on this machine ---
docs/INTERVIEW.md

# --- os / editor ---
.DS_Store
.idea/
.vscode/
