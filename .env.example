# 复制成 .env 后填。.env 已被 .gitignore，不会进仓库。
# LLM provider: openrouter | gemini | mock
HB_LLM_PROVIDER=mock

OPENROUTER_API_KEY=
HB_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

GEMINI_API_KEY=
HB_GEMINI_MODEL=gemini-2.0-flash

# 检索
HB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HB_RETRIEVAL_BACKEND=dense   # bm25 | dense | hybrid（留出集上 dense 最好，见 docs/EVALUATION.md）
