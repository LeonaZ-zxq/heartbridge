# 复制成 .env 后填。.env 已被 .gitignore，不会进仓库。

# ---------------------------------------------------------------------------
# LLM provider: groq | gemini | openrouter | mock
#
# 免费额度不是一个数字，是一个「按什么维度算」的问题。
# Gemini 的 429 里写着配额名：GenerateRequestsPerDayPerProjectPerModel
#                                                    ^^^^^^^^ 桶是按模型分的
# 所以同样一个免费 key，挑哪个模型能差 75 倍，而这跟模型好不好无关。
#
#   Groq              量级 30 RPM / 1000 RPD   ← 默认先试这家
#   Gemini 2.5-flash  量级 15 RPM / 1500 RPD
#   Gemini 3.6-flash  20 RPD                   ← 新模型预览档，点十下就没了
#   OpenRouter :free  约 50 RPD（按账号算，换模型不会得到新桶）
#
# 这个项目一次求助要打两次调用（危机确认 + 生成），按 RPD 除以 2 才是能演示几次。
# 数字会变，以各家控制台上的实际额度为准。
# ---------------------------------------------------------------------------
HB_LLM_PROVIDER=groq

GROQ_API_KEY=
HB_GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
HB_GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
HB_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct  # 去掉 :free 是付费版；免费池已下架该模型

# 超时。蒸馏这类长请求比聊天慢得多，60s 不够。
HB_LLM_TIMEOUT=180

# 检索
HB_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HB_RETRIEVAL_BACKEND=dense   # bm25 | dense | hybrid（留出集上 dense 最好，见 docs/EVALUATION.md）
